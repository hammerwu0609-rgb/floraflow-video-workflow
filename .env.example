# 服务端口
PORT=3001

# 单文件上传大小上限（MB）
MAX_FILE_SIZE_MB=500

# 数据存储目录
DATA_DIR=./server/data

# Session 密钥（部署时务必修改为随机字符串）
SESSION_SECRET=请替换为随机长字符串

# 团队账号（部署后请修改密码）
AUTH_EDITOR_USER=chris
AUTH_EDITOR_PASS=请设置剪辑师密码

AUTH_AIGC_USER=alex
AUTH_AIGC_PASS=请设置AIGC成员密码

AUTH_AIGC2_USER=alex2
AUTH_AIGC2_PASS=请设置AIGC成员2密码

AUTH_AIGC3_USER=alex3
AUTH_AIGC3_PASS=请设置AIGC成员3密码

AUTH_AUDIO_USER=sam
AUTH_AUDIO_PASS=请设置音效成员密码

AUTH_AUDIO2_USER=sam2
AUTH_AUDIO2_PASS=请设置音效成员2密码

AUTH_AUDIO3_USER=sam3
AUTH_AUDIO3_PASS=请设置音效成员3密码

# HTTPS 部署时设为 true
COOKIE_SECURE=false
